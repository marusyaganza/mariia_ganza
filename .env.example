# Public example only. Copy to .env and/or .env.local and replace with real values.
#   cp .env.example .env
#   cp .env.example .env.local
#
# Never commit .env or .env.local.

# Public Sentry DSN (exposed to the browser). Required for client error reporting.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional server/edge DSN. Falls back to NEXT_PUBLIC_SENTRY_DSN when unset.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry organization and project slugs (used when uploading source maps).
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Secret token for source map uploads. Do not prefix with NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=sntrys_yourAuthTokenHere
